{
  "name": "svhaui-helper",
  "private": true,
  "engines": {
    "node": ">=24"
  },
  "version": "3.6.0",
  "type": "module",
  "license": "GPL-3.0-only",
  "scripts": {
    "dev": "wxt",
    "dev:firefox": "wxt -b firefox",
    "dev:firefox:no-browser": "NO_BROWSER=true wxt -b firefox",
    "dev:firefox:open": "firefox \"about:debugging#/runtime/this-firefox\" & NO_BROWSER=true wxt -b firefox",
    "run:android": "web-ext run -s .output/firefox-mv2-dev -t firefox-android --firefox-apk org.mozilla.fenix --android-device $(adb get-serialno)",
    "build": "wxt build",
    "build:firefox": "wxt build -b firefox",
    "build:all": "pnpm build && pnpm build:firefox",
    "zip": "wxt zip",
    "zip:firefox": "wxt zip -b firefox",
    "zip:all": "pnpm zip && pnpm zip:firefox",
    "compile": "wxt prepare && tsc --noEmit",
    "postinstall": "wxt prepare",
    "lint": "eslint src && stylelint \"src/**/*.{css,scss}\"",
    "lint:fix": "eslint src --fix && stylelint \"src/**/*.{css,scss}\" --fix",
    "lint:css": "stylelint \"src/**/*.{css,scss}\"",
    "lint:css:fix": "stylelint \"src/**/*.{css,scss}\" --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "prepare": "husky"
  },
  "lint-staged": {
    "**/*.{ts,tsx,js,jsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "**/*.{css,scss}": [
      "stylelint --fix",
      "prettier --write"
    ],
    "**/*.{json,md}": [
      "prettier --write"
    ]
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.3",
    "@commitlint/config-conventional": "^21.2.3",
    "@eslint/js": "^10.0.1",
    "@types/chrome": "^0.3.0",
    "@types/node": "^26.6.3",
    "eslint": "^10.11.0",
    "eslint-config-prettier": "^10.0.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.5.1",
    "onnxruntime-web": "1.30.0",
    "prettier": "^3.9.9",
    "sass-embedded": "^1.104.1",
    "stylelint": "^17.16.0",
    "stylelint-config-standard-scss": "^17.0.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.70.1",
    "vite": "^8.3.1",
    "vitest": "^5.0.2",
    "web-ext": "^10.6.0",
    "wxt": "^0.21.4"
  },
  "dependencies": {
    "ical-generator": "^11.1.1"
  }
}
