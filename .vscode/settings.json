{
  // File Nesting - Nhóm gọn các file cấu hình và tài liệu ở root
  "explorer.fileNesting.enabled": true,
  "explorer.fileNesting.expand": false,
  "explorer.fileNesting.patterns": {
    "package.json": "package-lock.json, yarn.lock, pnpm-lock.yaml, bun.lockb, pnpm-workspace.yaml, .nvmrc, .node-version, tsconfig*.json, vitest.config.*, wxt.config.*",
    ".editorconfig": ".prettierrc*, .prettierignore, prettier.config.*, eslint.config.*, .eslintrc*, .eslintignore, commitlint.config.*, .commitlintrc*, .stylelintrc*, .stylelintignore, stylelint.config.*",
    "README.md": "CHANGELOG*, CONTRIBUTING*, LICENSE*, PRIVACY*",
    ".gitignore": ".gitattributes, .gitmodules",
    "*.ts": "$(capture).d.ts, $(capture).test.ts, $(capture).spec.ts",
    "*.js": "$(capture).d.ts, $(capture).test.js, $(capture).spec.js"
  },
  // Formatting & Linting
  "editor.defaultFormatter": "esbenp.prettier-vscode",
  "editor.formatOnSave": true,
  "editor.codeActionsOnSave": {
    "source.fixAll.eslint": "explicit"
  },
  // Language Configurations
  "[markdown]": {
    "editor.wordWrap": "on"
  },
  // Explorer Exclusions
  "files.exclude": {
    ".wxt": true,
    ".output": true,
    ".codegraph": true,
    "node_modules": true,
    "firefox:open": true,
    ".husky/_": true
  },
  // Search Exclusions
  "search.exclude": {
    "**/node_modules": true,
    "**/.output": true,
    "**/.wxt": true,
    "**/coverage": true
  }
}
